# ==========================================
# CareFlow AI - Backend Environment Variables
# ==========================================

# Server Port (auto-assigned on Render/Railway/Heroku via $PORT)
PORT=9090

# Database Configuration
H2_DB_PATH=./data/careflow_ai
H2_CONSOLE_ENABLED=false

# Allowed Frontend URLs for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173,https://your-frontend-deployment.vercel.app

# Security & JWT (Must be at least 32 characters long)
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_BYTES_LONG

# Groq Clinical AI Integration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
